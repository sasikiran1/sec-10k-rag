# Copy to .env and fill in. .env is gitignored.

# Which provider chat() uses: groq | gemini
LLM_PROVIDER=groq

# Groq (primary) — https://console.groq.com
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# Gemini (secondary, OpenAI-compatible endpoint) — https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-2.0-flash

# Postgres (container maps 5432 -> host 5433)
DATABASE_URL=postgresql://sec10k:sec10k@localhost:5433/sec10k

# SEC requires a descriptive User-Agent with a real name + email on every request.
SEC_USER_AGENT=sec-10k-rag/0.1 (Your Name your@email.com)
